<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="2.7.1" version="1.0">
  This file is intended to be loaded by Logisim (http://www.cburch.com/logisim/).
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Base" name="2">
    <tool name="Text Tool">
      <a name="text" val=""/>
      <a name="font" val="SansSerif plain 12"/>
      <a name="halign" val="center"/>
      <a name="valign" val="base"/>
    </tool>
  </lib>
  <main name="Half_Adder"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="2" map="Button2" name="Menu Tool"/>
    <tool lib="2" map="Ctrl Button1" name="Menu Tool"/>
    <tool lib="2" map="Button3" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="2" name="Poke Tool"/>
    <tool lib="2" name="Edit Tool"/>
    <tool lib="2" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin">
      <a name="tristate" val="false"/>
    </tool>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="labelloc" val="east"/>
    </tool>
    <sep/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="XNOR Gate"/>
    <tool lib="1" name="NOT Gate"/>
  </toolbar>

  <!-- ========================================== -->
  <!-- 1. HALF ADDER USING BASIC GATES (XOR & AND) -->
  <!-- ========================================== -->
  <circuit name="Half_Adder">
    <a name="circuit" val="Half_Adder"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="0" loc="(80,60)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(80,100)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(260,80)" name="XOR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(260,180)" name="AND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(400,80)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(400,180)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Carry"/>
      <a name="labelloc" val="east"/>
    </comp>
    <wire from="(80,60)" to="(140,60)"/>
    <wire from="(140,60)" to="(210,60)"/>
    <wire from="(140,60)" to="(140,160)"/>
    <wire from="(140,160)" to="(210,160)"/>
    <wire from="(80,100)" to="(120,100)"/>
    <wire from="(120,100)" to="(210,100)"/>
    <wire from="(120,100)" to="(120,200)"/>
    <wire from="(120,200)" to="(210,200)"/>
    <wire from="(260,80)" to="(400,80)"/>
    <wire from="(260,180)" to="(400,180)"/>
  </circuit>

  <!-- ========================================== -->
  <!-- 2. HALF ADDER USING NAND GATES ONLY (5 GATES) -->
  <!-- ========================================== -->
  <circuit name="Half_Adder_NAND">
    <a name="circuit" val="Half_Adder_NAND"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="0" loc="(70,50)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(70,210)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(250,130)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(370,70)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(370,190)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(490,130)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(490,270)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(570,130)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(570,270)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Carry"/>
      <a name="labelloc" val="east"/>
    </comp>
    <wire from="(70,50)" to="(130,50)"/>
    <wire from="(130,50)" to="(320,50)"/>
    <wire from="(130,50)" to="(130,110)"/>
    <wire from="(130,110)" to="(200,110)"/>
    <wire from="(70,210)" to="(130,210)"/>
    <wire from="(130,210)" to="(320,210)"/>
    <wire from="(130,210)" to="(130,150)"/>
    <wire from="(130,150)" to="(200,150)"/>
    <wire from="(250,130)" to="(280,130)"/>
    <wire from="(280,130)" to="(280,90)"/>
    <wire from="(280,90)" to="(320,90)"/>
    <wire from="(280,130)" to="(280,170)"/>
    <wire from="(280,170)" to="(320,170)"/>
    <wire from="(280,130)" to="(280,250)"/>
    <wire from="(280,250)" to="(440,250)"/>
    <wire from="(280,250)" to="(280,290)"/>
    <wire from="(280,290)" to="(440,290)"/>
    <wire from="(370,70)" to="(400,70)"/>
    <wire from="(400,70)" to="(400,110)"/>
    <wire from="(400,110)" to="(440,110)"/>
    <wire from="(370,190)" to="(400,190)"/>
    <wire from="(400,190)" to="(400,150)"/>
    <wire from="(400,150)" to="(440,150)"/>
    <wire from="(490,130)" to="(570,130)"/>
    <wire from="(490,270)" to="(570,270)"/>
  </circuit>

  <!-- ========================================== -->
  <!-- 3. FULL ADDER USING BASIC GATES (XOR, AND, OR) -->
  <!-- ========================================== -->
  <circuit name="Full_Adder">
    <a name="circuit" val="Full_Adder"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="0" loc="(70,60)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(70,100)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(70,210)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Cin"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(240,80)" name="XOR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(420,100)" name="XOR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(420,190)" name="AND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(420,280)" name="AND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(550,230)" name="OR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(600,100)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(600,230)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Cout"/>
      <a name="labelloc" val="east"/>
    </comp>
    <wire from="(70,60)" to="(130,60)"/>
    <wire from="(130,60)" to="(190,60)"/>
    <wire from="(130,60)" to="(130,260)"/>
    <wire from="(130,260)" to="(370,260)"/>
    <wire from="(70,100)" to="(150,100)"/>
    <wire from="(150,100)" to="(190,100)"/>
    <wire from="(150,100)" to="(150,300)"/>
    <wire from="(150,300)" to="(370,300)"/>
    <wire from="(240,80)" to="(290,80)"/>
    <wire from="(290,80)" to="(370,80)"/>
    <wire from="(290,80)" to="(290,170)"/>
    <wire from="(290,170)" to="(370,170)"/>
    <wire from="(70,210)" to="(320,210)"/>
    <wire from="(320,210)" to="(320,120)"/>
    <wire from="(320,120)" to="(370,120)"/>
    <wire from="(320,210)" to="(370,210)"/>
    <wire from="(420,100)" to="(600,100)"/>
    <wire from="(420,190)" to="(460,190)"/>
    <wire from="(460,190)" to="(460,210)"/>
    <wire from="(460,210)" to="(500,210)"/>
    <wire from="(420,280)" to="(460,280)"/>
    <wire from="(460,280)" to="(460,250)"/>
    <wire from="(460,250)" to="(500,250)"/>
    <wire from="(550,230)" to="(600,230)"/>
  </circuit>

  <!-- ========================================== -->
  <!-- 4. FULL ADDER USING NAND GATES ONLY (9 GATES) -->
  <!-- ========================================== -->
  <circuit name="Full_Adder_NAND">
    <a name="circuit" val="Full_Adder_NAND"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="0" loc="(60,30)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(60,150)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(60,220)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="Cin"/>
      <a name="labelloc" val="north"/>
    </comp>
    <!-- Half Adder 1 -->
    <comp lib="1" loc="(200,90)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(310,50)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(310,130)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(420,90)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <!-- Half Adder 2 -->
    <comp lib="1" loc="(530,140)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(640,100)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(640,180)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(750,140)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <!-- Carry Combination -->
    <comp lib="1" loc="(750,260)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(830,140)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Sum"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(830,260)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Carry"/>
      <a name="labelloc" val="east"/>
    </comp>
    <!-- Wires for Half Adder 1 -->
    <wire from="(60,30)" to="(110,30)"/>
    <wire from="(110,30)" to="(260,30)"/>
    <wire from="(110,30)" to="(110,70)"/>
    <wire from="(110,70)" to="(150,70)"/>
    <wire from="(60,150)" to="(110,150)"/>
    <wire from="(110,150)" to="(260,150)"/>
    <wire from="(110,150)" to="(110,110)"/>
    <wire from="(110,110)" to="(150,110)"/>
    <wire from="(200,90)" to="(230,90)"/>
    <wire from="(230,90)" to="(230,70)"/>
    <wire from="(230,70)" to="(260,70)"/>
    <wire from="(230,90)" to="(230,110)"/>
    <wire from="(230,110)" to="(260,110)"/>
    <wire from="(230,90)" to="(230,240)"/>
    <wire from="(230,240)" to="(700,240)"/>
    <wire from="(310,50)" to="(340,50)"/>
    <wire from="(340,50)" to="(340,70)"/>
    <wire from="(340,70)" to="(370,70)"/>
    <wire from="(310,130)" to="(340,130)"/>
    <wire from="(340,130)" to="(340,110)"/>
    <wire from="(340,110)" to="(370,110)"/>
    <!-- Wires from Half Adder 1 to Half Adder 2 -->
    <wire from="(420,90)" to="(450,90)"/>
    <wire from="(450,90)" to="(450,80)"/>
    <wire from="(450,80)" to="(590,80)"/>
    <wire from="(450,90)" to="(450,120)"/>
    <wire from="(450,120)" to="(480,120)"/>
    <wire from="(60,220)" to="(460,220)"/>
    <wire from="(460,220)" to="(460,160)"/>
    <wire from="(460,160)" to="(480,160)"/>
    <wire from="(460,220)" to="(570,220)"/>
    <wire from="(570,220)" to="(570,200)"/>
    <wire from="(570,200)" to="(590,200)"/>
    <!-- Half Adder 2 internal wires -->
    <wire from="(530,140)" to="(560,140)"/>
    <wire from="(560,140)" to="(560,120)"/>
    <wire from="(560,120)" to="(590,120)"/>
    <wire from="(560,140)" to="(560,160)"/>
    <wire from="(560,160)" to="(590,160)"/>
    <wire from="(560,140)" to="(560,280)"/>
    <wire from="(560,280)" to="(700,280)"/>
    <wire from="(640,100)" to="(670,100)"/>
    <wire from="(670,100)" to="(670,120)"/>
    <wire from="(670,120)" to="(700,120)"/>
    <wire from="(640,180)" to="(670,180)"/>
    <wire from="(670,180)" to="(670,160)"/>
    <wire from="(670,160)" to="(700,160)"/>
    <!-- Final outputs -->
    <wire from="(750,140)" to="(830,140)"/>
    <wire from="(750,260)" to="(830,260)"/>
  </circuit>

</project>
