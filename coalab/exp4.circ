    <wire from="(110,110)" to="(140,110)"/>
    <wire from="(200,90)" to="(230,90)"/>
    <wire from="(230,90)" to="(230,70)"/>
    <wire from="(230,70)" to="(250,70)"/>
    <wire from="(230,90)" to="(230,110)"/>
    <wire from="(230,110)" to="(250,110)"/>
    <wire from="(310,50)" to="(340,50)"/>
    <wire from="(340,50)" to="(340,70)"/>
    <wire from="(340,70)" to="(360,70)"/>
    <wire from="(310,130)" to="(340,130)"/>
    <wire from="(340,130)" to="(340,110)"/>
    <wire from="(340,110)" to="(360,110)"/>
    <wire from="(340,130)" to="(340,240)"/>
    <wire from="(340,240)" to="(690,240)"/>
    <!-- Half Subtractor 2 Wires -->
