  <!-- ========================================== -->
  <!-- 4. FULL SUBTRACTOR USING NAND GATES ONLY (9 GATES) -->
  <!-- ========================================== -->
  <circuit name="Full_Subtractor_NAND">
    <a name="circuit" val="Full_Subtractor_NAND"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="0" loc="(60,30)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
