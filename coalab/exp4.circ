      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(310,50)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(310,130)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(420,90)" name="NAND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <!-- Half Subtractor 2 -->
