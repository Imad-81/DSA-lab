  <!-- ========================================== -->
  <!-- 1. HALF SUBTRACTOR USING BASIC GATES (XOR, NOT, AND) -->
  <!-- ========================================== -->
  <circuit name="Half_Subtractor">
    <a name="circuit" val="Half_Subtractor"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <comp lib="0" loc="(80,60)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="A"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="0" loc="(80,180)" name="Pin">
      <a name="tristate" val="false"/>
      <a name="label" val="B"/>
      <a name="labelloc" val="north"/>
    </comp>
    <comp lib="1" loc="(260,80)" name="XOR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="1" loc="(190,180)" name="NOT Gate"/>
    <comp lib="1" loc="(260,200)" name="AND Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(400,80)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Difference"/>
      <a name="labelloc" val="east"/>
    </comp>
    <comp lib="0" loc="(400,200)" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="Borrow"/>
      <a name="labelloc" val="east"/>
    </comp>
    <wire from="(80,60)" to="(120,60)"/>
    <wire from="(120,60)" to="(200,60)"/>
    <wire from="(120,60)" to="(120,180)"/>
    <wire from="(120,180)" to="(160,180)"/>
    <wire from="(190,180)" to="(210,180)"/>
    <wire from="(80,180)" to="(100,180)"/>
    <wire from="(100,180)" to="(100,100)"/>
    <wire from="(100,100)" to="(200,100)"/>
    <wire from="(100,180)" to="(100,220)"/>
    <wire from="(100,220)" to="(210,220)"/>
    <wire from="(260,80)" to="(400,80)"/>
    <wire from="(260,200)" to="(400,200)"/>
  </circuit>

